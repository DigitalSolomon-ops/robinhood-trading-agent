.env
.env.*
!.env.example
logs/
data/*.db
# SQLite writes these beside the db. A run interrupted mid-write leaves one
# behind, and `data/*.db` does not match them -- so without these a `git add -A`
# would stage a fragment of the audit log / paper ledger.
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
data/private/
data/proving_runs/
__pycache__/
*.pyc
.venv/
.pytest_cache/

# ds-build-agent handoff artifacts (in-place build)
BLOCKERS.md
GHL-SETUP.md

# The equities lane's operator halt marker -- an operator drops this file to
# stop the equities lane. It is transient operational state, not source, so it
# must never ride into git via `git add -A`. (The crypto lane's STOP_TRADING is
# the opposite case: it is a COMMITTED disarm marker that must reach every
# clone, so it is deliberately NOT ignored -- git_hygiene's _MUST_NOT_BE_IGNORED
# pins that.)
STOP_TRADING_EQUITIES

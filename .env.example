ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_BASE_URL=https://trading.robinhood.com
TRADING_MODE=paper
TRADING_ENABLED=false
# Risk caps are set in config/trading_rules.yaml (risk:), NOT here. The code
# hard-rejects anything above max_trade_amount_usd 100 / max_daily_loss_usd 100
# / max_open_positions 10. Do not re-add MAX_* keys here; they are not read.
POLL_INTERVAL_SECONDS=60
# === Alpaca (equities + single-leg options lane) ===
# Paper keys from https://app.alpaca.markets/paper/dashboard/overview
# ALPACA_PAPER=true uses the paper endpoint. Leave true until the lane is proven.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
ALPACA_ENABLED=false

CRYPTOPANIC_API_KEY=
NEWS_PROVIDER=cryptopanic
COINGECKO_API_KEY=
CRYPTO_MARKET_PROVIDER=coingecko
FRED_API_KEY=
MACRO_PROVIDER=fred

# === Massive (formerly Polygon.io) -- read-only EOD/delayed equities data ===
# Feeds decisions + proving only; the Robinhood connector stays the execution
# price. Read env-first here, then Secret Manager secret `massive-api` (see
# vault.map.json) -- leave blank locally to use the SM fallback.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# Lean container for the Entry-Hit Alerter poll cycle (Cloud Run Job).
# NOTIFICATION ONLY -- reads delayed prices and sends alert emails. No
# trading-lane / crypto deps, so the image cannot place an order even in
# principle.
FROM python:3.11-slim

WORKDIR /app
# httpx + PyYAML for the Massive read and config; google-cloud-storage for the
# shared day-state object (the scouts write it, this reads it back).
RUN pip install --no-cache-dir \
    "httpx==0.28.1" "PyYAML==6.0.3" "google-cloud-storage==2.18.2"

# Copy EVERY module imported at load -- the options-scout packaging lesson:
#   * src/__init__.py                    -- makes `src` a package
#   * src/market_data_fields.py          -- imported by equity_intelligence.massive_client
#   * src/market_hours.py                -- imported by entry_alerts.alerter (RTH guard)
#   * src/entry_alerts/                  -- this routine
#   * src/equity_intelligence/           -- MassiveClient (current-price snapshot)
#   * src/options_scout/                 -- entry_alerts.config reuses its secret helper
#   * src/smallcap_scout/                -- kept for parity with the scout images
COPY src/__init__.py ./src/__init__.py
COPY src/market_data_fields.py ./src/market_data_fields.py
COPY src/market_hours.py ./src/market_hours.py
COPY src/entry_alerts/ ./src/entry_alerts/
COPY src/equity_intelligence/ ./src/equity_intelligence/
COPY src/options_scout/ ./src/options_scout/
COPY src/smallcap_scout/ ./src/smallcap_scout/
COPY config/options_scout.yaml ./config/options_scout.yaml
COPY config/smallcap_scout.yaml ./config/smallcap_scout.yaml
COPY config/entry_alerts.yaml ./config/entry_alerts.yaml

# Secrets arrive as env (MASSIVE_API_KEY, GMAIL_APP_PASSWORD) injected by Cloud
# Run from Secret Manager; never shell out to gcloud in-container. The GCS
# client uses the Cloud Run runtime service-account ADC, not gcloud.
ENV DS_VAULT_NO_GCLOUD=1 PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-m", "src.entry_alerts"]

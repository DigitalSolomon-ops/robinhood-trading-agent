# Lean container for the Options Scout daily email (Cloud Run Job).
# ANALYSIS ONLY -- needs just httpx + PyYAML; no trading-lane / crypto deps.
FROM python:3.11-slim

WORKDIR /app
# google-cloud-storage lets the scout persist its ranked plays to the shared
# entry-alert day-state (best-effort; the email never depends on it).
RUN pip install --no-cache-dir \
    "httpx==0.28.1" "PyYAML==6.0.3" "google-cloud-storage==2.18.2"

# Only the analysis-only packages + the scout's config. Nothing from the
# trading lanes is copied, so the image cannot place an order even in principle.
# entry_alerts (+ market_hours it imports) is copied so the scout's best-effort
# entry-alert persistence hook actually runs -- both analysis-only.
COPY src/__init__.py ./src/__init__.py
COPY src/market_data_fields.py ./src/market_data_fields.py
COPY src/market_hours.py ./src/market_hours.py
COPY src/scout_email_branding.py ./src/scout_email_branding.py
COPY assets/logo-email.png ./assets/logo-email.png
COPY src/options_scout/ ./src/options_scout/
COPY src/equity_intelligence/ ./src/equity_intelligence/
COPY src/entry_alerts/ ./src/entry_alerts/
COPY config/options_scout.yaml ./config/options_scout.yaml
COPY config/entry_alerts.yaml ./config/entry_alerts.yaml

# Secrets arrive as env (MASSIVE_API_KEY, GMAIL_APP_PASSWORD) injected by Cloud
# Run from Secret Manager; never shell out to gcloud in-container.
ENV DS_VAULT_NO_GCLOUD=1 PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-m", "src.options_scout"]

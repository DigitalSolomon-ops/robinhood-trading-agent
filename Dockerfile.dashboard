# 007 trader dashboard -- Cloud Run web SERVICE (control surface + per-lane arm toggle).
# Arm state is shared via Firestore (TRADER_ARM_FIRESTORE_PROJECT) so the toggle
# reaches a co-located trader that reads the same store. This image serves the
# dashboard only; data-heavy views degrade gracefully until a trader runtime is
# co-located. It carries the trading-lane modules because the dashboard imports
# them, but it runs NO trading loop and its order paths default to dry-run/paper.
FROM python:3.11-slim

WORKDIR /app

# Direct deps (fastapi/uvicorn/etc.) + Firestore for the shared arm store +
# Cloud Storage for the Scout Reports / Report Recipients tabs (reads the shared
# entry-alerts bucket via ADC; the import stays lazy+guarded so a missing lib or
# bucket degrades to the local fallback rather than crashing the tab).
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    "google-cloud-firestore>=2.11,<3" "google-cloud-storage==2.18.2"

COPY src/ ./src/
COPY config/ ./config/
# The dashboard serves /assets/logo.png (favicon + header); without this the app
# 404s the logo. Ships the brand assets into the image.
COPY assets/ ./assets/
RUN mkdir -p data logs

# ADC on Cloud Run (never shell out to gcloud in-container); IAP assertion is
# verified in src/web_security.py when IAP_AUDIENCE is set.
ENV DS_VAULT_NO_GCLOUD=1 PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080

ENTRYPOINT ["python", "-m", "src.web"]

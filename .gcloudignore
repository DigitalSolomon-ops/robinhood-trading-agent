# Keep the Cloud Build context lean and secret-free. The Dockerfile copies only
# src/options_scout, src/equity_intelligence, src/__init__.py, and one config
# file, so everything else is upload weight at best and a secret at worst.
.venv/
.git/
__pycache__/
*.pyc
.env
.env.*
!.env.example
data/
logs/
*.db
*.db-*
*.sqlite*
node_modules/
archive/
.pytest_cache/
builds/
dist/
STOP_TRADING*
